# Server Configuration
PORT=5000

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/ecommerce_db?schema=public"

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here


# Admin Registration Authorization
ADMIN_REGISTRATION_SECRET=your_admin_registration_secret_here

# Paystack Gateway (Test/Live Credentials)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email Services (Nodemailer / SMTP - Optional)
EMAIL_HOST=xxxxxxxxx
EMAIL_PORT=xxx
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password