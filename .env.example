

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/ecommerce_db?schema=public"

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# Admin Registration Authorization
ADMIN_REGISTRATION_SECRET=your_admin_registration_secret_here

# Paystack Configuration (Test/Live Credentials)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Email Services (Nodemailer / SMTP)
SMTP_HOST=your_smtp_host
SMTP_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
